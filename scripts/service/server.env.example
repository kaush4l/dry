# ~/.config/dry/server.env for dry-server.service (chmod 600). The token every
# client from another machine must carry (docs/server.md). Make one with:
#   openssl rand -hex 16
DRY_SERVER_TOKEN=replace-with-a-long-random-token
# Optional: ask the token of this machine too (behind a proxy here).
# DRY_SERVER_STRICT=1
